APP_NAME=Feitoo
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.feitoo.com.br
CORS_ALLOWED_ORIGINS=https://feitoo.com.br
FRONTEND_URL=https://feitoo.com.br
SANCTUM_STATEFUL_DOMAINS=feitoo.com.br
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.feitoo.com.br/api/auth/google/callback

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=feitoo_production
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.feitoo.com.br
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
FEITOO_PROCESSING_DISK=processing
FEITOO_PROCESSING_TTL_MINUTES=120
FEITOO_MAX_FILES=20
FEITOO_MAX_PROCESSING_FILES=250
FEITOO_MAX_PROCESSING_ITEMS=4000
FEITOO_MAX_TOTAL_SIZE_KB=40960
FREE_MAX_FILES_PER_PROCESSING=20
FEITOO_MAX_REQUEST_SIZE_KB=30720
FREE_DAILY_FILES=50
# XML para Excel e Produtos dos XMLs apenas
XML_DEMO_MAX_FILES_PER_PROCESSING=3
XML_DEMO_DAILY_FILES=6
SINGLE_PURCHASE_100_CENTS=490
SINGLE_PURCHASE_250_CENTS=690
SINGLE_PURCHASE_500_CENTS=990
SINGLE_PURCHASE_1000_CENTS=1490
# TEST MODE only. No public key is required for hosted Checkout.
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FEITOO_MAX_FILE_SIZE_KB=10240
FEITOO_CREATE_PER_MINUTE=10
FEITOO_UPLOAD_PER_MINUTE=10
FEITOO_ACCESS_PER_MINUTE=60
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=90
FEITOO_PROCESSING_QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="suporte@feitoo.com.br"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

STRIPE_PRO_PRICE_ID=
PRO_MONTHLY_CENTS=2990
PRO_MAX_FILES_PER_PROCESSING=250
PRO_DAILY_FILES=500
PRO_RETENTION_MINUTES=1440

